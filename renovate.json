{
    "extends": [
      "config:recommended",
      ":semanticCommits",
      ":pinDependencies"
    ],
    "baseBranches": [
      "main"
    ],
    "timezone": "America/Los_Angeles",
    "branchPrefix": "renovate-",
    "lockFileMaintenance": {
      "enabled": true,
      "automerge": true,
      "schedule": [
        "after 2pm on Saturday"
      ]
    },
    "vulnerabilityAlerts": {
      "enabled": true,
      "labels": [
        "security"
      ]
    },
    "osvVulnerabilityAlerts": true,
    "packageRules": [
      {
        "groupName": "minor and patch version changes",
        "matchUpdateTypes": [
          "patch",
          "pin",
          "digest",
          "minor"
        ],
        "automerge": true,
        "schedule": [
          "after 2pm on Saturday"
        ],
        "matchPackageNames": [
          "/^.+/"
        ]
      },
      {
        "groupName": "major version changes",
        "matchUpdateTypes": [
          "major"
        ],
        "automerge": false,
        "schedule": [
          "after 2pm on Monday"
        ],
        "matchPackageNames": [
          "/^.+/"
        ]
      },
      {
        "description": "@octokit/rest 21+ is ESM-only and 22+ requires node 20. sizewatcher is CommonJS and supports node 18 at runtime.",
        "matchPackageNames": [
          "@octokit/rest"
        ],
        "allowedVersions": "<21"
      },
      {
        "description": "pretty-bytes 6+ is ESM-only. sizewatcher is CommonJS and supports node 18 at runtime.",
        "matchPackageNames": [
          "pretty-bytes"
        ],
        "allowedVersions": "<6"
      },
      {
        "matchDatasources": [
          "orb"
        ],
        "matchUpdateTypes": [
          "patch",
          "minor"
        ],
        "automerge": true
      }
    ]
  }
